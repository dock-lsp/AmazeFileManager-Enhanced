<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/holo_dark_background">

    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:background="@color/holo_dark_background">

        <TextView
            android:id="@+id/terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="14sp"
            android:typeface="monospace"
            android:textColor="@android:color/white"
            android:background="@color/holo_dark_background"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.1"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:longClickable="true" />

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray" />

    <com.amaze.filemanager.ui.fragments.terminal.TerminalFragment.TerminalEditText
        android:id="@+id/terminal_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:padding="8dp"
        android:textSize="14sp"
        android:typeface="monospace"
        android:textColor="@android:color/white"
        android:background="@color/holo_dark_background"
        android:fontFamily="monospace"
        android:hint="@string/terminal_input_hint"
        android:textColorHint="@android:color/darker_gray"
        android:imeOptions="actionSend"
        android:inputType="text|textNoSuggestions|textVisiblePassword"
        android:maxLines="1"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
