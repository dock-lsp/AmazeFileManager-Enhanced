<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pdf_split_mode"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingBottom="8dp" />

    <Spinner
        android:id="@+id/spinner_split_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pdf_page_range"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/et_page_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pdf_page_range_hint"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/output_prefix"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/et_output_prefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/output_prefix_hint"
        android:inputType="text" />

</LinearLayout>
